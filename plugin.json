{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "yomiyasu-studio",
  "version": "0.2.6",
  "description": "Yomiyasu StudioのMCPとスキル。用途と作風を保ち、日本語の修正案を比較します。",
  "author": {
    "name": "StudioYebisu"
  },
  "license": "MIT",
  "keywords": [
    "japanese",
    "proofreading",
    "yomiyasu",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Yomiyasu Studio",
        "shortDescription": "原文と作風を残し、日本語の修正案を比較する。",
        "developerName": "StudioYebisu",
        "category": "Productivity",
        "defaultPrompt": [
          "この文章を、用途と作風を保って校正してください。"
        ]
      }
    }
  }
}
